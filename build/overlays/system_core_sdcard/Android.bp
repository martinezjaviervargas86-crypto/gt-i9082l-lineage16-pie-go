cc_binary {
    srcs: [
        "sdcard.cpp",
        "fuse.cpp",
        "main.c",
    ],
    name: "sdcard",
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-Wno-error",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libminijail",
        "libpackagelistparser",
    ],
    sanitize: {
        misc_undefined: ["integer"],
    },
}
