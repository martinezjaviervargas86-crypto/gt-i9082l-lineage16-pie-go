diff --git a/kernel/sys.c b/kernel/sys.c
index 7823a9c..070fc64 100644
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -1950,6 +1950,15 @@ SYSCALL_DEFINE5(prctl, int, option, unsigned long, arg2, unsigned long, arg3,
 		case PR_SET_VMA:
 			error = prctl_set_vma(arg2, arg3, arg4, arg5);
 			break;
+		case PR_SET_NO_NEW_PRIVS:
+			if (arg2 != 1 || arg3 || arg4 || arg5)
+				return -EINVAL;
